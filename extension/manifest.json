{
  "manifest_version": 3,
  "name": "Blocky",
  "version": "0.1.0",
  "description": "Shows Blocky's suggestions in new tabs and sends blocked sites to them.",
  "permissions": [
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
